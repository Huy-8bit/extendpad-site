---
// A line illustration (not a screenshot): the Mac desktop extends onto the tablet over a USB-C cable,
// with one window spanning both screens and the cursor crossing over.
---
<figure class="hero-art" aria-labelledby="hero-art-caption">
  <svg viewBox="0 0 640 400" role="img" aria-label="Illustration: a Mac and an Android tablet joined by a USB-C cable; one window spans both screens.">
    <defs>
      <linearGradient id="ha-screen" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#ffffff" />
        <stop offset="1" stop-color="#eef4ff" />
      </linearGradient>
      <linearGradient id="ha-tablet" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#f6f9ff" />
        <stop offset="1" stop-color="#e3edff" />
      </linearGradient>
      <clipPath id="ha-mac-clip"><rect x="34" y="62" width="300" height="186" rx="4" /></clipPath>
      <clipPath id="ha-tab-clip"><rect x="404" y="122" width="200" height="128" rx="4" /></clipPath>
    </defs>

    <!-- Floor shadow -->
    <ellipse cx="320" cy="338" rx="300" ry="20" class="ha-floor" />

    <!-- Mac -->
    <rect x="24" y="52" width="320" height="206" rx="14" class="ha-bezel" />
    <rect x="34" y="62" width="300" height="186" rx="4" fill="url(#ha-screen)" />
    <g clip-path="url(#ha-mac-clip)">
      <rect x="34" y="62" width="300" height="12" class="ha-menubar" />
      <rect x="300" y="65" width="10" height="6" rx="1.5" class="ha-menuicon" />
      <rect x="58" y="96" width="150" height="104" rx="6" class="ha-window" />
      <rect x="58" y="96" width="150" height="16" rx="6" class="ha-window-bar" />
      <path d="M72 128h96M72 140h120M72 152h80M72 164h108" class="ha-lines" />
      <!-- spanning window, left part -->
      <rect x="250" y="150" width="140" height="80" rx="6" class="ha-window ha-window-blue" />
      <rect x="250" y="150" width="140" height="14" rx="6" class="ha-window-bar ha-window-bar-blue" />
      <path d="M262 182h60M262 194h80M262 206h44" class="ha-lines" />
    </g>
    <path d="M6 266h356l-18 14H24z" class="ha-base" />
    <path d="M150 266h68" class="ha-notch" />

    <!-- Cable -->
    <path d="M344 214c38 0 26 86 82 86s44-36 62-36" class="ha-cable" />
    <path d="M344 214c38 0 26 86 82 86s44-36 62-36" class="ha-cable-flow" />

    <!-- Tablet -->
    <rect x="394" y="112" width="220" height="148" rx="14" class="ha-tablet" />
    <rect x="404" y="122" width="200" height="128" rx="4" fill="url(#ha-tablet)" />
    <g clip-path="url(#ha-tab-clip)">
      <!-- spanning window, right part (continues from the Mac) -->
      <rect x="264" y="160" width="190" height="80" rx="6" class="ha-window ha-window-blue" />
      <rect x="264" y="160" width="190" height="14" rx="6" class="ha-window-bar ha-window-bar-blue" />
      <path d="M412 192h30M412 204h36M412 216h20" class="ha-lines" />
      <rect x="470" y="140" width="116" height="80" rx="6" class="ha-window" />
      <rect x="470" y="140" width="116" height="14" rx="6" class="ha-window-bar" />
      <path d="M482 170h70M482 182h86M482 194h56" class="ha-lines" />
    </g>
    <text x="504" y="274" class="ha-label">ExtendPad Display</text>

    <!-- Cursor travelling across the two screens -->
    <g class="ha-cursor">
      <path d="M0 0l10 24 3.6-10.4L24 10z" />
    </g>
  </svg>
  <figcaption id="hero-art-caption">Illustration · one desktop across both screens</figcaption>
</figure>
