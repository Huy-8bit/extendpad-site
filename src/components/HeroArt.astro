---
// An HTML/CSS illustration (not a screenshot): the Mac desktop extends onto the tablet over USB-C,
// with one window spanning both screens and the cursor crossing over.
---
<figure class="stage reveal" aria-labelledby="stage-caption">
  <span class="stage-orb stage-orb-1" aria-hidden="true"></span>
  <span class="stage-orb stage-orb-2" aria-hidden="true"></span>
  <div class="stage-scene" role="img" aria-label="Illustration: a Mac and an Android tablet joined by a USB-C cable, with one window spanning both screens.">
    <div class="device mac">
      <div class="screen">
        <span class="menubar"><i></i><b></b></span>
        <span class="win win-a"><i></i></span>
        <span class="win win-span win-span-l"><i></i></span>
      </div>
      <span class="mac-base"></span>
    </div>
    <svg class="cable" viewBox="0 0 100 60" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <linearGradient id="cable-g" x1="0" x2="1">
          <stop offset="0" stop-color="#7dd3fc" />
          <stop offset=".55" stop-color="#a78bfa" />
          <stop offset="1" stop-color="#f0abfc" />
        </linearGradient>
      </defs>
      <path d="M59.4 40.4 C 64 54, 75 53, 78 37.2" class="cable-base" />
      <path d="M59.4 40.4 C 64 54, 75 53, 78 37.2" class="cable-flow" />
    </svg>
    <div class="device tablet">
      <div class="screen">
        <span class="win win-span win-span-r"><i></i></span>
        <span class="win win-b"><i></i></span>
      </div>
    </div>
    <span class="tablet-tag">ExtendPad Display</span>
    <span class="cursor" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="18" height="18"><path d="M3 2l7.5 19 2.6-7.6L21 11z" /></svg>
    </span>
  </div>
  <figcaption id="stage-caption">Illustration · one desktop across two screens</figcaption>
</figure>
