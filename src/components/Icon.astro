---
// 24px stroke icons (lucide-style). Brand mark for GitHub is filled.
export type IconName =
  | 'display' | 'cursor' | 'chip' | 'refresh' | 'key' | 'menu' | 'lock'
  | 'github' | 'download' | 'arrow-right' | 'arrow-up-right' | 'apple' | 'android' | 'copy' | 'check' | 'plus' | 'usb'
  | 'aperture' | 'plug' | 'tablet' | 'sparkles' | 'shield' | 'alert';
interface Props {
  name: IconName;
  size?: number;
  class?: string;
}
const { name, size = 20, class: cls } = Astro.props;
const paths: Record<IconName, string> = {
  display: '<rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8"/><path d="M12 17v4"/>',
  cursor: '<path d="M4 4l7.07 17 2.51-7.39L21 11.07z"/>',
  chip: '<rect x="5" y="5" width="14" height="14" rx="2"/><rect x="9" y="9" width="6" height="6" rx="1"/><path d="M9 2v3M15 2v3M9 19v3M15 19v3M2 9h3M2 15h3M19 9h3M19 15h3"/>',
