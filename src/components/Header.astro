---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { LINKS, url } from '../config';
const home = url('/');
const nav = [
  { href: '#how-it-works', label: 'How it works' },
  { href: '#features', label: 'Features' },
  { href: '#setup', label: 'Setup' },
  { href: '#faq', label: 'FAQ' },
];
---
<header class="nav-wrap">
  <nav class="nav glass" aria-label="Main" data-shine>
    <a href={home} class="brand" aria-label="ExtendPad home"><Logo /><span>ExtendPad</span></a>
    <ul class="nav-links">
      {nav.map((n) => <li><a href={`${home}${n.href}`}>{n.label}</a></li>)}
    </ul>
    <a class="nav-icon" href={LINKS.repo} rel="noopener" aria-label="ExtendPad on GitHub"><Icon name="github" size={18} /></a>
    <a class="pill pill-primary pill-sm" href={`${home}#download`}>Download</a>
  </nav>
</header>
