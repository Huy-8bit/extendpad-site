---
interface Props {
  id: string;
  label: string;
  title: string;
  lead?: string;
  align?: 'center' | 'start';
}
const { id, label, title, lead, align = 'center' } = Astro.props;
---
<header class:list={['sec-head', { 'sec-head-start': align === 'start' }]}>
  <p class="eyebrow"><span class="eyebrow-dot" aria-hidden="true"></span>{label}</p>
  <h2 id={id} set:html={title} />
  {lead && <p class="sec-lead">{lead}</p>}
</header>
