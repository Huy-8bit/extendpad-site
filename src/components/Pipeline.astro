---
// The video path from the Mac to the tablet as one "liquid" track, plus the two side channels.
import Icon, { type IconName } from './Icon.astro';
const stops: { name: string; role: string; icon: IconName; zone: 'mac' | 'cable' | 'tablet' }[] = [
  { name: 'CGVirtual<wbr>Display', role: 'Virtual monitor', icon: 'display', zone: 'mac' },
  { name: 'ScreenCapture<wbr>Kit', role: 'Captures it', icon: 'aperture', zone: 'mac' },
  { name: 'Video<wbr>Toolbox', role: 'Hardware H.264', icon: 'chip', zone: 'mac' },
  { name: 'Loopback socket', role: '127.0.0.1 only', icon: 'plug', zone: 'mac' },
  { name: 'adb reverse', role: 'Over USB', icon: 'usb', zone: 'cable' },
  { name: 'Media<wbr>Codec', role: 'Hardware decoder', icon: 'chip', zone: 'tablet' },
  { name: 'Surface<wbr>View', role: 'On screen', icon: 'tablet', zone: 'tablet' },
];
---
<figure class="flow reveal" aria-labelledby="flow-caption">
  <div class="flow-zones" aria-hidden="true">
    <span class="zone zone-mac">Mac · Swift / SwiftUI</span>
    <span class="zone zone-cable">USB-C</span>
    <span class="zone zone-tablet">Tablet · Kotlin</span>
  </div>
  <ol class="track">
    {stops.map((s, i) => (
      <li class:list={['stop', `stop-${s.zone}`]} style={`--i:${i}`}>
        <span class="bubble glass"><Icon name={s.icon} size={20} /></span>
        <strong set:html={s.name} />
        <span class="stop-role">{s.role}</span>
        <span class="sr-only">{s.zone === 'mac' ? 'on the Mac' : s.zone === 'cable' ? 'over the USB-C cable' : 'on the tablet'}</span>
      </li>
    ))}
  </ol>
  <div class="side-channels">
    <div class="channel glass" data-shine>
      <span class="channel-key">Cursor · 120 Hz</span>
      <p>Sent separately and drawn by the tablet, so it stays smooth regardless of the video frame rate.</p>
    </div>
    <div class="channel glass" data-shine>
      <span class="channel-key">Pairing · HMAC-SHA256</span>
      <p>A pairing token is delivered over ADB, and both sides use it to authenticate with HMAC-SHA256.</p>
    </div>
  </div>
  <figcaption id="flow-caption" class="sr-only">CGVirtualDisplay → ScreenCaptureKit → VideoToolbox H.264 → loopback socket → adb reverse over USB → MediaCodec → SurfaceView</figcaption>
</figure>
