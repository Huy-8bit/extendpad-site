---
// ExtendPad mark: two glass panes (Mac screen and tablet) with an iridescent edge.
interface Props {
  size?: number;
}
const { size = 30 } = Astro.props;
const id = `lg${Math.random().toString(36).slice(2, 7)}`;
---
<svg width={size} height={size} viewBox="0 0 32 32" fill="none" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={`${id}a`} x1="2" y1="4" x2="30" y2="28" gradientUnits="userSpaceOnUse">
      <stop stop-color="#7dd3fc" />
      <stop offset=".5" stop-color="#a78bfa" />
      <stop offset="1" stop-color="#f0abfc" />
    </linearGradient>
  </defs>
  <rect x="2" y="5" width="19" height="14" rx="4" fill={`url(#${id}a)`} opacity=".9" />
  <rect x="13" y="12" width="17" height="15" rx="4" fill="rgb(255 255 255 / .22)" stroke={`url(#${id}a)`} stroke-width="1.6" />
  <path d="M17 17h9M17 21h6" stroke="#fff" stroke-width="1.6" stroke-linecap="round" opacity=".85" />
</svg>
