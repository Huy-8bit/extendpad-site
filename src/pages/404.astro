---
import Base from '../layouts/Base.astro';
import { url } from '../config';
---
<Base title="Page not found · ExtendPad" noindex>
  <main id="main" class="notfound">
    <div class="container">
      <div class="section-index"><span>404 / NOT FOUND</span></div>
      <h1>No display detected <em>at this address.</em></h1>
      <p>The page you’re looking for doesn’t exist or has moved.</p>
      <a class="btn btn-primary btn-lg" href={url('/')}>Back to ExtendPad</a>
    </div>
  </main>
</Base>
