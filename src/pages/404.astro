---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { url } from '../config';
---
<Base title="Page not found · ExtendPad" noindex>
  <main id="main" class="notfound">
    <div class="wrap">
      <div class="notfound-card glass" data-shine>
        <p class="eyebrow"><span class="eyebrow-dot" aria-hidden="true"></span>Error 404</p>
        <h1>No display detected <em>at this address.</em></h1>
        <p>The page you’re looking for doesn’t exist or has moved.</p>
        <a class="pill pill-primary pill-lg" href={url('/')}>Back to ExtendPad <Icon name="arrow-right" size={18} /></a>
      </div>
    </div>
  </main>
</Base>
