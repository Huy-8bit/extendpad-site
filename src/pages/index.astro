---
import Base from '../layouts/Base.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import HeroArt from '../components/HeroArt.astro';
import Pipeline from '../components/Pipeline.astro';
import SectionHead from '../components/SectionHead.astro';
import Gallery from '../components/Gallery.astro';
import { DOWNLOADS, LINKS } from '../config';
import { features, setup, performance, limitations, faq } from '../content';
import { getScreenshots } from '../lib/screenshots';

const shots = getScreenshots();
// Section numbers follow the sections actually shown (the gallery appears only with real photos).
const order = ['how', 'features', ...(shots.length ? ['gallery'] : []), 'download', 'setup', 'performance', 'limitations', 'faq'];
const n = (key: string) => String(order.indexOf(key) + 1).padStart(2, '0');
let stepNo = 0;
---
<Base>
  <main id="main">
    <!-- Hero -->
    <section class="hero" aria-labelledby="hero-title">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="hero-label"><span aria-hidden="true"></span>MAC + ANDROID TABLET · OVER USB-C</p>
          <h1 id="hero-title">ExtendPad</h1>
          <p class="hero-statement">A USB-C second display for your Mac, <em>using an Android tablet.</em></p>
          <p class="hero-lead">ExtendPad creates a real extended monitor that macOS lists in System Settings → Displays, and streams it to your tablet with hardware video over the cable. Drag windows onto it like any other screen.</p>
          <div class="hero-actions">
            <a class="btn btn-primary btn-lg" href="#download"><Icon name="download" size={18} />Download</a>
            <a class="btn btn-ghost btn-lg" href={LINKS.repo} rel="noopener"><Icon name="github" size={18} />View on GitHub</a>
          </div>
          <ul class="badges" aria-label="At a glance">
            <li>USB-C, no Wi-Fi</li>
            <li>Local only</li>
            <li>macOS 13+</li>
            <li>Android 8+ / HarmonyOS 2–4</li>
          </ul>
        </div>
        <HeroArt />
      </div>
    </section>
    <div class="tested-band">
      <div class="container tested-inner">
        <span class="tested-label">TESTED ON</span>
        <ul>
          <li><b>Huawei MatePad SE</b><span>AGS6-W09 · HarmonyOS 2 / Android 10</span></li>
          <li><b>MacBook Pro M1 Pro</b><span>macOS 15.7.4</span></li>
          <li><b>Other tablets</b><span>Should work, untested</span></li>
        </ul>
      </div>
    </div>

    <!-- How it works -->
    <section class="section" id="how-it-works" aria-labelledby="how-title">
      <div class="container">
        <SectionHead id="how-title" index={n('how')} label="HOW IT WORKS" aside="ONE CABLE. NO NETWORK." title="A virtual monitor on the Mac, <em>a hardware decoder on the tablet.</em>" lead="macOS gets a genuine second display. ExtendPad captures it, encodes it in hardware and sends it through adb reverse over the USB cable, where the tablet decodes and shows it." />
        <Pipeline />
      </div>
    </section>

    <!-- Features -->
    <section class="section" id="features" aria-labelledby="features-title">
      <div class="container">
        <SectionHead id="features-title" index={n('features')} label="FEATURES" aside="EXTENDED, NOT MIRRORED" title="A second screen <em>that behaves like one.</em>" />
        <ul class="feature-grid">
          {features.map((f, i) => (
            <li class:list={['feature', { 'feature-wide': i === 0 }]}>
              <span class="feature-icon"><Icon name={f.icon as IconName} size={22} /></span>
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <Gallery index={n('gallery')} shots={shots} />

    <!-- Download -->
    <section class="section" id="download" aria-labelledby="download-title">
      <div class="container">
        <SectionHead id="download-title" index={n('download')} label="DOWNLOAD" aside="FROM GITHUB RELEASES" title="Two apps. <em>One cable.</em>" lead="Install the menu-bar app on your Mac and the companion app on your tablet." />
        <div class="download-grid">
          <div class="download-card">
            <span class="download-icon"><Icon name="apple" size={26} /></span>
            <h3>Mac</h3>
            <p class="download-meta">{DOWNLOADS.mac.size} · {DOWNLOADS.mac.requirements.join(' · ')}</p>
            <a class="btn btn-primary btn-lg download-btn" href={DOWNLOADS.mac.href}><Icon name="download" size={18} />{DOWNLOADS.mac.label}</a>
            <p class="download-note">Swift / SwiftUI menu-bar app. Needs <code>adb</code> on the Mac.</p>
          </div>
          <div class="download-card">
            <span class="download-icon"><Icon name="android" size={26} /></span>
            <h3>Android tablet</h3>
            <p class="download-meta">{DOWNLOADS.android.size} · {DOWNLOADS.android.requirements.join(' · ')}</p>
            <a class="btn btn-primary btn-lg download-btn" href={DOWNLOADS.android.href}><Icon name="download" size={18} />{DOWNLOADS.android.label}</a>
            <p class="download-note">Kotlin app. English and Vietnamese UI on both apps.</p>
          </div>
        </div>
        <div class="download-footer">
          <a class="text-link" href={LINKS.releases} rel="noopener">All releases <Icon name="arrow-up-right" size={16} /></a>
          <p>The Mac app already contains the APK and can install it on the tablet over USB, so the separate APK download is optional.</p>
        </div>
      </div>
    </section>

    <!-- Setup -->
    <section class="section" id="setup" aria-labelledby="setup-title">
      <div class="container">
        <SectionHead id="setup-title" index={n('setup')} label="SETUP GUIDE" aside="TABLET · MAC · CONNECT" title="From unboxed tablet <em>to second screen.</em>" />
        <div class="setup-grid">
          {setup.map((group) => (
            <div class="setup-card">
              <h3>{group.title}</h3>
              <ol>
                {group.steps.map((s) => {
                  stepNo += 1;
                  return <li><span class="step-no" aria-hidden="true">{String(stepNo).padStart(2, '0')}</span><span set:html={s} /></li>;
                })}
              </ol>
            </div>
          ))}
        </div>
        <div class="command">
          <span class="command-label">Install adb on the Mac</span>
          <code id="adb-command">brew install android-platform-tools</code>
          <button type="button" class="copy-btn" data-copy="#adb-command" aria-label="Copy command">
            <Icon name="copy" size={16} /><span>Copy</span>
          </button>
        </div>
      </div>
    </section>

    <!-- Performance -->
    <section class="section" id="performance" aria-labelledby="performance-title">
      <div class="container">
        <SectionHead id="performance-title" index={n('performance')} label="PERFORMANCE" aside="MEASURED, NOT PROMISED" title="Measured on <em>the test hardware.</em>" lead={`${performance.hardware}. Other hardware may differ.`} />
        <div class="table-wrap">
          <table class="perf-table">
            <caption>Measured on the test hardware: {performance.hardware}</caption>
            <thead><tr><th scope="col">Measurement</th><th scope="col">Result</th><th scope="col">Note</th></tr></thead>
            <tbody>
              {performance.rows.map((r) => (
                <tr><th scope="row">{r.metric}</th><td>{r.value}</td><td>{'note' in r ? r.note : ''}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Limitations -->
    <section class="section" id="limitations" aria-labelledby="limitations-title">
      <div class="container">
        <SectionHead id="limitations-title" index={n('limitations')} label="LIMITATIONS" aside="READ BEFORE INSTALLING" title="What to know <em>before you install.</em>" />
        <ul class="limits">
          {limitations.map((l) => <li set:html={l} />)}
        </ul>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section" id="faq" aria-labelledby="faq-title">
      <div class="container faq-grid">
        <div>
          <SectionHead id="faq-title" index={n('faq')} label="FAQ" title="Common questions." />
          <p class="faq-more">Something else? <a class="text-link" href={LINKS.issues} rel="noopener">Open an issue <Icon name="arrow-up-right" size={16} /></a></p>
        </div>
        <div class="faq-list">
          {faq.map((f) => (
            <details>
              <summary><span>{f.q}</span><Icon name="plus" size={18} /></summary>
              <p set:html={f.a} />
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>

  <script>
    document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const text = document.querySelector(btn.dataset.copy ?? '')?.textContent ?? '';
        const label = btn.querySelector('span');
        try {
          await navigator.clipboard.writeText(text);
          if (label) label.textContent = 'Copied';
        } catch {
          if (label) label.textContent = 'Press ⌘C';
        }
        setTimeout(() => label && (label.textContent = 'Copy'), 1600);
      });
    });
  </script>
</Base>
